# Copy this file to ".env" and fill it in.

# Required: your Claude API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Who Jarvis works for, and what he calls you
JARVIS_OWNER=Jake Young
JARVIS_USER_NAME=sir
# What Jarvis says as soon as he gets a command
JARVIS_THINKING_PHRASE=Thinking...

# Brain. Effort: low (fastest) / medium / high (smartest, slower)
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=low
# Saving credit: background jobs (email sorting) use this cheap model whatever JARVIS_MODEL is,
# and after this many idle minutes Jarvis starts a fresh conversation (he still remembers recent chats).
JARVIS_HELPER_MODEL=claude-haiku-5-5
# Daily API budget in dollars (0 = none): warning at 80%; at 100% cheapest model + email watch paused until midnight
JARVIS_DAILY_BUDGET=1.00
JARVIS_IDLE_RESET_MINUTES=60

# Free offline mode with a model on this PC through Ollama (see "Free offline mode" in the README).
# claude = always Claude; local = always the local model; auto = Claude, switching to the local model when the
# credit runs out, the daily budget is spent, or the internet is down.
JARVIS_BRAIN=claude
JARVIS_LOCAL_MODEL=llama3.2:3b
JARVIS_OLLAMA_URL=http://localhost:11434

# Weather & news. Location blank = detect automatically. Units: metric or imperial.
JARVIS_LOCATION=
JARVIS_WEATHER_UNITS=metric
# News ticker sources. Leave blank for the built-in balanced mix (Reuters, AP, BBC, DW, PBS, Euronews, The Hill,
# plus tech: Ars Technica, The Verge, TechCrunch, Wired, MIT Tech Review).
# To choose your own: Name=RSS-url, comma-separated
JARVIS_NEWS_FEEDS=

# Keyboard shortcut that brings up Jarvis and starts listening, from any app (e.g. ctrl+alt+j, ctrl+shift+space, alt+f1)
JARVIS_HOTKEY=ctrl+alt+j

# Email watch: alerts you (and your phone) about important new emails. on/off, and how often to check.
JARVIS_EMAIL_WATCH=on
JARVIS_EMAIL_WATCH_MINUTES=5

# Spotify: paste your app's Client ID here (see "Connect Spotify" in the README), then run jarvis.bat --connect-spotify
JARVIS_SPOTIFY_CLIENT_ID=

# Minutes before each calendar event that Jarvis briefs you on it (0 = off)
JARVIS_MEETING_BRIEF_MINUTES=10

# Proactive suggestions you approve or dismiss: at most this many a day (0 = off)
JARVIS_SUGGESTIONS_PER_DAY=3
# Nightly memory tidy-up: on/off
JARVIS_MEMORY_TIDY=on

# Telegram: your private bot's token from @BotFather (see "Telegram" in the README). Blank = off.
JARVIS_TELEGRAM_TOKEN=

# Which webcam to use (0 = the built-in one)
JARVIS_CAMERA_INDEX=0
# Desk scanner: the webcam pointed down at your mat. auto = a second webcam if one is plugged in, else the one above.
JARVIS_DESK_CAMERA=auto
# Free offline mode's eyes for the desk scanner (download it with: ollama pull moondream)
JARVIS_LOCAL_VISION_MODEL=moondream

# Dictate anywhere: press this in any app, speak, press it again, and the text is typed for you (blank = off)
JARVIS_DICTATE_HOTKEY=ctrl+alt+d
# Live captions of what Jarvis says, at the bottom of the screen over every app (or say "captions on/off")
JARVIS_CAPTIONS=off
# Hide card numbers, passwords and keys before they reach the AI, memory or logs: on/off
JARVIS_REDACT=on

# "Initiate Open House protocol": the apps it opens, comma-separated
JARVIS_OPEN_HOUSE=spotify, chrome
# Mood mode: a Spotify search to play when it starts (blank = no music), e.g. lo-fi beats
JARVIS_MOOD_MUSIC=
# Ask my files: folders to index and search, comma-separated
JARVIS_FILE_FOLDERS=~/Documents,~/Desktop
# "What was I doing?" journal: notes the app and window you're in once a minute, on this PC only. on/off
JARVIS_JOURNAL=off
# Clipboard history ("paste what I copied about the flights"), kept in memory only: on/off
JARVIS_CLIPBOARD_HISTORY=on
# End-of-day wrap-up time (blank = off). On Sundays it's the weekly review.
JARVIS_DAY_WRAP=21:30
# Perimeter alerts: failed Windows sign-ins and new devices on your home Wi-Fi: on/off
JARVIS_PERIMETER=on
# Offline "Hey Jarvis" wake word, a tiny detector on this PC (or say "offline wake word on"): on/off
JARVIS_WAKE_WORD=off
# Always-visible status strip in the top-right corner (or say "status strip on"): on/off
JARVIS_STATUS_STRIP=off

# Instant replies: "Right away, sir" / "One moment, sir" the moment a command arrives (off = always the thinking phrase)
JARVIS_QUICK_ACKS=on
# Voice that fits the moment: quieter late at night, brisker for warnings, warmer for good news: on/off
JARVIS_VOICE_TONE=on
# Where's my stuff (parcels from shipping emails) and subscription radar (renewal warnings from receipts): on/off
JARVIS_PACKAGE_WATCH=on
JARVIS_SUBSCRIPTION_WATCH=on
# "Leave now" nudges for calendar events with an address (free OpenStreetMap routing). Home address blank = your rough
# location from the internet. Travel mode: driving, walking or cycling. Buffer: minutes to spare.
JARVIS_LEAVE_NUDGES=on
JARVIS_HOME_ADDRESS=
JARVIS_TRAVEL_MODE=driving
JARVIS_LEAVE_BUFFER_MINUTES=10
# Daily notes ("capture: ..."): one Markdown file a day in this folder (Obsidian can open it)
JARVIS_DAILY_NOTES_FOLDER=~/Documents/Jarvis Daily Notes

# Voice. Other good voices: en-GB-ThomasNeural, en-US-GuyNeural, en-GB-SoniaNeural
# Full list: run  edge-tts --list-voices
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_VOICE_RATE=+5%
JARVIS_VOICE_PITCH=+0Hz
# Speech recognition model: tiny.en (fastest), base.en, small.en (most accurate, slower)
JARVIS_WHISPER_MODEL=base.en
# Same, for the HUD when it uses Jarvis's own speech recognition (if Edge's isn't available). Default tiny.en (fastest).
JARVIS_HUD_WHISPER_MODEL=tiny.en
JARVIS_WAKE_WORDS=jarvis,jervis,javis,jarvas,travis
# Power-up phrases ("Wake up, daddy's home"): Jarvis replies "Welcome home" with the weather and agenda.
# Leave blank for the defaults. Comma-separated; punctuation doesn't matter.
JARVIS_ACTIVATION_PHRASES=
# Spoken power-up phrases also need a clap within 5 seconds (in the HUD). on/off
JARVIS_CLAP_TO_WAKE=on
# Power-up music: blank = data/activation-song.mp3 if it's there; or a path to an audio file; or off
JARVIS_ACTIVATION_SONG=
JARVIS_FOLLOW_UP_SECONDS=6
