# Copy this file to ".env" and fill it in.

# Required: your Claude API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Who Jarvis works for, and what he calls you
JARVIS_OWNER=Jake Young
JARVIS_USER_NAME=sir
# What Jarvis says as soon as he gets a command
JARVIS_THINKING_PHRASE=Thinking...

# Brain. Effort: low (fastest) / medium / high (smartest, slower)
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=low

# Weather & news. Location blank = detect automatically. Units: metric or imperial.
JARVIS_LOCATION=
JARVIS_WEATHER_UNITS=metric
# News ticker sources. Leave blank for the built-in balanced mix (Reuters, AP, BBC, DW, PBS, Euronews, The Hill,
# plus tech: Ars Technica, The Verge, TechCrunch, Wired, MIT Tech Review).
# To choose your own: Name=RSS-url, comma-separated
JARVIS_NEWS_FEEDS=

# Keyboard shortcut that brings up Jarvis and starts listening, from any app (e.g. ctrl+alt+j, ctrl+shift+space, alt+f1)
JARVIS_HOTKEY=ctrl+alt+j

# Which webcam to use (0 = the built-in one)
JARVIS_CAMERA_INDEX=0

# Voice. Other good voices: en-GB-ThomasNeural, en-US-GuyNeural, en-GB-SoniaNeural
# Full list: run  edge-tts --list-voices
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_VOICE_RATE=+5%
JARVIS_VOICE_PITCH=+0Hz
# Speech recognition model: tiny.en (fastest), base.en, small.en (most accurate, slower)
JARVIS_WHISPER_MODEL=base.en
JARVIS_WAKE_WORDS=jarvis,jervis,javis,jarvas,travis
JARVIS_FOLLOW_UP_SECONDS=6
